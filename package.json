{
  "name": "alif-digest",
  "version": "1.1.9",
  "description": "Autonomous AI Signal Digest CLI for tracking high-signal AI breakthroughs.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "alif": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev": "tsx src/cli/index.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs,json,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "keywords": [
    "ai",
    "cli",
    "digest",
    "newsletter",
    "automation",
    "ollama",
    "anthropic",
    "signal"
  ],
  "author": "qaribhaider",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qaribhaider/alif.git"
  },
  "bugs": {
    "url": "https://github.com/qaribhaider/alif/issues"
  },
  "homepage": "https://github.com/qaribhaider/alif#readme",
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.64",
    "@ai-sdk/openai": "^3.0.48",
    "@openrouter/ai-sdk-provider": "^2.3.3",
    "ai": "^6.0.141",
    "axios": "^1.14.0",
    "better-sqlite3": "^12.8.0",
    "cheerio": "^1.2.0",
    "commander": "^14.0.3",
    "consola": "^3.4.2",
    "dotenv": "^17.3.1",
    "ollama-ai-provider-v2": "^3.5.0",
    "prompts": "^2.4.2",
    "rss-parser": "^3.13.0",
    "talisman": "^1.1.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "@types/prompts": "^2.4.9",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.1.2"
  }
}
